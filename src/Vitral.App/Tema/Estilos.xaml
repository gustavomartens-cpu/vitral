<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Vitral.App"
                    xmlns:tema="clr-namespace:Vitral.App.Tema"
                    xmlns:ui="clr-namespace:Vitral.Ui;assembly=Vitral.Ui">

    <local:CorParaPincel x:Key="CorParaPincel" />
    <local:TemValor x:Key="TemValor" />
    <local:Iguais x:Key="Iguais" />
    <tema:MeiaAltura x:Key="MeiaAltura" />
    <BooleanToVisibilityConverter x:Key="BoolParaVisivel" />
    <local:NuloComoMarca x:Key="NuloComoMarca" />
    <local:TemaParaValores x:Key="TemaParaValores" />
    <local:TransparenciaNoDeslizante x:Key="TransparenciaNoDeslizante" />

    <!-- Foco de teclado sempre visível: contorno branco de 2 px (spec da interface §4.2) -->
    <Style x:Key="FocoVitral">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="9" RadiusY="9" Stroke="{StaticResource Foco}" StrokeThickness="2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TituloSecao" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FonteCorpo}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Rotulo" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}" />
        <Setter Property="Margin" Value="6,10,0,6" />
    </Style>

    <!-- Botões -->
    <Style x:Key="BotaoBase" TargetType="Button">
        <Setter Property="tema:Efeitos.Afundar" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVitral}" />
        <Setter Property="FontFamily" Value="{StaticResource FonteCorpo}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="Foreground" Value="{DynamicResource TextoSobreAmbar}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="tema:Efeitos.Brilho" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Âmbar cheio (spec da interface §4.3): a cor de ação da janela -->
                        <Border x:Name="Fundo" CornerRadius="{StaticResource RaioBotao}" Background="{DynamicResource Ambar}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <!-- Brilho (spec do ajuste visual §3.3): faixa diagonal que atravessa o botão; os cantos recortam o pincel -->
                        <Border x:Name="Faixa" CornerRadius="{StaticResource RaioBotao}" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                                    <LinearGradientBrush.RelativeTransform><TranslateTransform X="-1" /></LinearGradientBrush.RelativeTransform>
                                    <GradientStop Offset="0.35" Color="#00FFFFFF" />
                                    <GradientStop Offset="0.5" Color="#8CFFFFFF" />
                                    <GradientStop Offset="0.65" Color="#00FFFFFF" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="Opacity" Value="0.92" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Fundo" Property="Opacity" Value="0.8" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Fundo" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoVidro" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="Foreground" Value="{DynamicResource Texto}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Secundário (spec da interface §4.3): fundo translúcido discreto, sem borda -->
                    <Border x:Name="Fundo" CornerRadius="{StaticResource RaioBotao}" Background="{DynamicResource Superficie}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="Background" Value="{DynamicResource SuperficieHover}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Fundo" Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botão só com ícone (+, ⋯, ⚙) da barra lateral (spec da interface §4.3): 26×26, sem fundo até o mouse passar -->
    <Style x:Key="BotaoIcone" TargetType="Button">
        <Setter Property="tema:Efeitos.Afundar" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVitral}" />
        <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}" />
        <Setter Property="FontFamily" Value="{StaticResource FonteIcones}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fundo" CornerRadius="7" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource SuperficieHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chave liga/desliga (spec da interface §4.3): um CheckBox em forma de interruptor, trilho 34×18, ligado em âmbar -->
    <Style x:Key="Chave" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVitral}" />
        <Setter Property="Foreground" Value="{DynamicResource Texto}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent" LastChildFill="True">
                        <Border x:Name="Trilho" DockPanel.Dock="Right" Width="34" Height="18" CornerRadius="9" Background="{DynamicResource SuperficieHover}"
                                BorderBrush="{DynamicResource Borda}" BorderThickness="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Ellipse x:Name="Bola" Width="12" Height="12" Fill="{DynamicResource TextoSecundario}" HorizontalAlignment="Left" Margin="2,0,0,0" />
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Trilho" Property="Background" Value="{DynamicResource Ambar}" />
                            <Setter TargetName="Trilho" Property="BorderBrush" Value="{DynamicResource Ambar}" />
                            <Setter TargetName="Bola" Property="Fill" Value="{DynamicResource TextoSobreAmbar}" />
                            <Setter TargetName="Bola" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Bola" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Abas: um sublinhado âmbar com brilho que desliza até a ativa (spec do ajuste visual §4.4) -->
    <Style x:Key="AbasVitral" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,12,0,0" />
        <Setter Property="tema:Efeitos.Deslize" Value="True" />
        <Setter Property="tema:Efeitos.DeslizeRecuo" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Linha}" BorderThickness="0,0,0,1">
                            <Grid>
                                <TabPanel x:Name="PainelItens" IsItemsHost="True" />
                                <Canvas IsHitTestVisible="False">
                                    <Border x:Name="Indicador" Height="2" Canvas.Bottom="0" CornerRadius="1" Background="{DynamicResource Ambar}" Visibility="Hidden" />
                                </Canvas>
                            </Grid>
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AbaVitral" TargetType="TabItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVitral}" />
        <Setter Property="Foreground" Value="{DynamicResource Texto}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <!-- Cor só no cabeçalho: o conteúdo da aba herda o Foreground do TabItem -->
                    <Grid Margin="0,0,20,0" Background="Transparent">
                        <!-- O sublinhado é o Indicador das AbasVitral, que desliza entre as abas -->
                        <ContentPresenter x:Name="Cabecalho" ContentSource="Header" Margin="0,4,0,9" TextElement.Foreground="{DynamicResource TextoSecundario}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Cabecalho" Property="TextElement.Foreground" Value="{DynamicResource Texto}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Lista de perfis: gema, barra âmbar no selecionado, etiqueta "ativo" -->
    <Style x:Key="ListaPerfis" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="ItemListaPerfil" TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVitral}" />
        <Setter Property="Foreground" Value="{DynamicResource Texto}" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid MinHeight="32">
                        <Border x:Name="Fundo" CornerRadius="8" Background="Transparent" Padding="10,6">
                            <DockPanel>
                                <Rectangle DockPanel.Dock="Left" Width="9" Height="9" RadiusX="2" RadiusY="2" Margin="0,0,10,0"
                                           Fill="{Binding CorGema, Converter={StaticResource CorParaPincel}}" RenderTransformOrigin="0.5,0.5">
                                    <Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform>
                                </Rectangle>
                                <TextBlock DockPanel.Dock="Right" Text="ativo" FontSize="10" Foreground="{DynamicResource Ambar}" VerticalAlignment="Center"
                                           Visibility="{Binding Ativo, Converter={StaticResource BoolParaVisivel}}" />
                                <TextBlock Text="{Binding Nome}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="Background" Value="{DynamicResource Superficie}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Fundo" Property="Background" Value="{DynamicResource Selecao}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cartão de vidro -->
    <!-- Cartão (spec da interface §4.3): fundo translúcido, borda fina, cantos 12; quieto ao passar o mouse -->
    <Style x:Key="CartaoVidro" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Superficie}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Linha}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RaioCartao}" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- Seletor em pílula alta (ListBox horizontal, setas trocam a opção): a escolhida é um indicador âmbar que
         desliza até ela (spec do ajuste visual §4.4; forma C, escolhida pelo Gustavo em 25/10) -->
    <!-- Escolha segmentada neutra (spec da interface §4.3): a marcada num cinza claro que desliza até ela; "Não mexer"
         aparece como "—" (com a dica "Não mexer") -->
    <Style x:Key="SeletorPilula" TargetType="ListBox">
        <Setter Property="SelectedValuePath" Value="Valor" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="tema:Efeitos.Deslize" Value="True" />
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock x:Name="Rotulo" Text="{Binding Rotulo}" />
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Rotulo}" Value="Não mexer">
                            <Setter TargetName="Rotulo" Property="Text" Value="—" />
                            <Setter TargetName="Rotulo" Property="ToolTip" Value="Não mexer" />
                            <Setter TargetName="Rotulo" Property="MinWidth" Value="14" />
                            <Setter TargetName="Rotulo" Property="TextAlignment" Value="Center" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border CornerRadius="8" Background="{DynamicResource Superficie}" Padding="2">
                        <Grid>
                            <Canvas IsHitTestVisible="False">
                                <Border x:Name="Indicador" CornerRadius="6" Background="{DynamicResource Selecao}" Visibility="Hidden" />
                            </Canvas>
                            <ItemsPresenter x:Name="PainelItens" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVitral}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Pilula" CornerRadius="6" Padding="11,5" Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Texto}" /></Trigger>
                                    <!-- O fundo da escolhida é o Indicador do seletor; aqui só o texto muda -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Pilula" Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource Texto}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Caixa de texto de vidro (cor livre) -->
    <Style x:Key="CaixaVidro" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Texto}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Ambar}" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Fundo" CornerRadius="8" Background="{DynamicResource Superficie}" BorderBrush="{DynamicResource Linha}" BorderThickness="1" Padding="8,5">
                        <ScrollViewer x:Name="PART_ContentHost" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Fundo" Property="BorderBrush" Value="{StaticResource Foco}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quadrado de cor da paleta -->
    <Style x:Key="BotaoCor" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVitral}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Quadrado 20×20, cantos 5; a cor escolhida ganha um anel de 2 px (spec da interface §4.3) -->
                    <Border x:Name="Anel" CornerRadius="7" BorderThickness="2" BorderBrush="Transparent" Padding="0">
                        <Border x:Name="Q" Width="18" Height="18" CornerRadius="5" Background="{Binding Converter={StaticResource CorParaPincel}}"
                                BorderBrush="{DynamicResource Linha}" BorderThickness="1" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Q" Property="BorderBrush" Value="{DynamicResource Texto}" /></Trigger>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource Iguais}">
                                    <Binding />
                                    <Binding Path="DataContext.CorDestaque" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="Anel" Property="BorderBrush" Value="{DynamicResource Texto}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menus (spec do ajuste visual §4.3): vidro escuro, ícone à esquerda, pílula âmbar no hover, perigo em vermelho.
         Implícitos: valem para o menu da doca, o da bandeja e os menus de texto do editor. -->
    <Style TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource Texto}" />
        <Setter Property="FontFamily" Value="{StaticResource FonteCorpo}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- A margem dá espaço para a sombra dentro do popup -->
                    <Border Margin="12" Background="{DynamicResource FundoMenu}" BorderBrush="{DynamicResource BordaVidro}" BorderThickness="1" CornerRadius="12" Padding="6">
                        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.45" /></Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource Texto}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Fundo" Height="32" MinWidth="190" CornerRadius="8" Padding="10,0" Background="Transparent">
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="16" Margin="0,0,10,0">
                                <ContentPresenter x:Name="Icone" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  TextElement.FontFamily="{StaticResource FonteIcones}" TextElement.FontSize="13"
                                                  TextElement.Foreground="{DynamicResource TextoSecundario}">
                                    <ContentPresenter.RenderTransform><TranslateTransform x:Name="Passo" /></ContentPresenter.RenderTransform>
                                </ContentPresenter>
                                <TextBlock x:Name="Marcado" Text="&#xE73E;" FontFamily="{StaticResource FonteIcones}" FontSize="12"
                                           Foreground="{DynamicResource Ambar}" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource TextoSecundario}"
                                       FontSize="11" Margin="16,0,0,0" VerticalAlignment="Center" />
                            <ContentPresenter x:Name="Texto" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Marcado" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource HoverMenu}" />
                            <Setter TargetName="Icone" Property="TextElement.Foreground" Value="{DynamicResource Ambar}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsHighlighted" Value="True" />
                                <Condition Property="tema:Efeitos.Perigo" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource PerigoHover}" />
                            <Setter TargetName="Icone" Property="TextElement.Foreground" Value="{DynamicResource Perigo}" />
                            <Setter TargetName="Texto" Property="TextElement.Foreground" Value="{DynamicResource Perigo}" />
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Passo" Storyboard.TargetProperty="X" To="3" Duration="0:0:0.12" /></Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="Passo" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12" /></Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="6,5" Background="{DynamicResource SeparadorMenu}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aba Aparência: paleta de cores escolhível ("do tema" primeiro, em texto) -->
    <Style x:Key="SeletorCor" TargetType="ListBox">
        <Setter Property="SelectedValuePath" Value="Valor" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="ToolTip" Value="{Binding Rotulo}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVitral}" />
                    <Setter Property="Margin" Value="0,0,4,4" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Aro" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Padding="2">
                                    <Border x:Name="Q" MinWidth="22" Height="22" CornerRadius="5" BorderBrush="{DynamicResource Linha}" BorderThickness="1"
                                            Background="{Binding Valor, Converter={StaticResource CorParaPincel}}">
                                        <TextBlock x:Name="T" Text="{Binding Rotulo}" FontSize="11" Foreground="{DynamicResource Texto}" Margin="8,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                    </Border>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Valor}" Value="{x:Static ui:Opcoes.Nulo}">
                                        <Setter TargetName="T" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Q" Property="Background" Value="{DynamicResource Superficie}" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Q" Property="BorderBrush" Value="{DynamicResource Texto}" /></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Aro" Property="BorderBrush" Value="{DynamicResource Ambar}" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aba Aparência: grade de temas com miniatura -->
    <Style x:Key="GradeTemas" TargetType="ListBox">
        <Setter Property="SelectedValuePath" Value="Valor" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></Setter.Value></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox"><ItemsPresenter /></ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVitral}" />
                    <Setter Property="Margin" Value="0,0,8,8" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Aro" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Linha}" Background="{DynamicResource Superficie}" Padding="5">
                                    <StackPanel>
                                        <local:PreviaAparencia Height="50" Raio="6" Valores="{Binding Valor, Converter={StaticResource TemaParaValores}}" />
                                        <TextBlock Text="{Binding Rotulo}" FontSize="11.5" Foreground="{DynamicResource Texto}" HorizontalAlignment="Center" Margin="0,5,0,1" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Aro" Property="Background" Value="{DynamicResource SuperficieHover}" /></Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Aro" Property="BorderBrush" Value="{DynamicResource Ambar}" />
                                        <Setter TargetName="Aro" Property="Background" Value="{DynamicResource Selecao}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Deslizante (transparência da aba Aparência): trilho fino, parte cheia em âmbar, bolinha clara -->
    <Style x:Key="TrilhoDeslizante" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" /></Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="DeslizanteVitral" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVitral}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Track x:Name="PART_Track" Height="22">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource TrilhoDeslizante}" Command="Slider.DecreaseLarge" Background="{DynamicResource Ambar}" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource TrilhoDeslizante}" Command="Slider.IncreaseLarge" Background="{DynamicResource SuperficieHover}" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Ellipse x:Name="Bola" Width="16" Height="16" Fill="{DynamicResource Texto}" Stroke="{DynamicResource Ambar}" StrokeThickness="2" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bola" Property="StrokeThickness" Value="3" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
