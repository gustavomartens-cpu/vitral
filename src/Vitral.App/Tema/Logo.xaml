<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- V de vidro (spec do ajuste visual §5): três cacos, esquerdo branco, direito prata e o meio em âmbar.
         O retângulo transparente mantém a caixa 0..100 em qualquer tamanho. -->
    <LinearGradientBrush x:Key="LogoMeio" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFFFD27A" />
        <GradientStop Offset="1" Color="#FFD98E1C" />
    </LinearGradientBrush>
    <Geometry x:Key="LogoCacoEsquerdo">M8,12 L34,12 L50,52 L50,92 Z</Geometry>
    <Geometry x:Key="LogoCacoDireito">M92,12 L66,12 L50,52 L50,92 Z</Geometry>
    <Geometry x:Key="LogoCacoMeio">M34,12 L66,12 L50,52 Z</Geometry>

    <DrawingImage x:Key="Logo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,100" /></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FFF2F2F2" Geometry="{StaticResource LogoCacoEsquerdo}"><GeometryDrawing.Pen><Pen Brush="#FF0F1014" Thickness="3" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing>
                <GeometryDrawing Brush="#FFA9ADB6" Geometry="{StaticResource LogoCacoDireito}"><GeometryDrawing.Pen><Pen Brush="#FF0F1014" Thickness="3" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource LogoMeio}" Geometry="{StaticResource LogoCacoMeio}"><GeometryDrawing.Pen><Pen Brush="#FF0F1014" Thickness="3" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Para 16 e 24 px: contorno mais grosso, para os cacos não se misturarem -->
    <DrawingImage x:Key="LogoPequeno">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="Transparent"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,100" /></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FFF2F2F2" Geometry="{StaticResource LogoCacoEsquerdo}"><GeometryDrawing.Pen><Pen Brush="#FF0F1014" Thickness="4" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing>
                <GeometryDrawing Brush="#FFA9ADB6" Geometry="{StaticResource LogoCacoDireito}"><GeometryDrawing.Pen><Pen Brush="#FF0F1014" Thickness="4" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing>
                <GeometryDrawing Brush="{StaticResource LogoMeio}" Geometry="{StaticResource LogoCacoMeio}"><GeometryDrawing.Pen><Pen Brush="#FF0F1014" Thickness="4" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
