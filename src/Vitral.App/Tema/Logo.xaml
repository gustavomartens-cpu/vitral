<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Losango de vitral: quadrado girado 45° com 4 gomos, âmbar e azul alternados (spec §2.2) -->
    <DrawingImage x:Key="Logo">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup.Transform><RotateTransform Angle="45" CenterX="50" CenterY="50" /></DrawingGroup.Transform>
                <GeometryDrawing Brush="Transparent"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,100,100" /></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FFF2B544"><GeometryDrawing.Geometry><RectangleGeometry Rect="18,18,30.5,30.5" RadiusX="4" RadiusY="4" /></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FF4C7DF0"><GeometryDrawing.Geometry><RectangleGeometry Rect="51.5,18,30.5,30.5" RadiusX="4" RadiusY="4" /></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FF4C7DF0"><GeometryDrawing.Geometry><RectangleGeometry Rect="18,51.5,30.5,30.5" RadiusX="4" RadiusY="4" /></GeometryDrawing.Geometry></GeometryDrawing>
                <GeometryDrawing Brush="#FFF2B544"><GeometryDrawing.Geometry><RectangleGeometry Rect="51.5,51.5,30.5,30.5" RadiusX="4" RadiusY="4" /></GeometryDrawing.Geometry></GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
</ResourceDictionary>
