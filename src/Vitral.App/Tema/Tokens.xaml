<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Vidro fumê da janela principal (spec da interface §4.2); a doca, o notch e as ilhas redefinem por parte -->
    <Color x:Key="CorNoite">#FF0E0E10</Color>
    <Color x:Key="CorNoiteVidro">#8C0C0C0E</Color>
    <Color x:Key="CorNoiteLateral">#330A0A0C</Color>
    <Color x:Key="CorAmbar">#FFF2B544</Color>
    <Color x:Key="CorAzul">#FF4C7DF0</Color>
    <Color x:Key="CorTexto">#FFEDEDF0</Color>
    <Color x:Key="CorTextoSecundario">#99EDEDF0</Color>
    <Color x:Key="CorTextoSobreAmbar">#FF1A1206</Color>
    <Color x:Key="CorLinha">#14FFFFFF</Color>
    <Color x:Key="CorBorda">#1AFFFFFF</Color>
    <Color x:Key="CorEspecular">#24FFFFFF</Color>
    <Color x:Key="CorSuperficie">#0DFFFFFF</Color>
    <Color x:Key="CorSuperficieHover">#17FFFFFF</Color>
    <Color x:Key="CorSelecao">#24FFFFFF</Color>
    <Color x:Key="CorFoco">#B3FFFFFF</Color>

    <SolidColorBrush x:Key="Noite" Color="{StaticResource CorNoite}" />
    <SolidColorBrush x:Key="NoiteVidro" Color="{StaticResource CorNoiteVidro}" />
    <SolidColorBrush x:Key="NoiteLateral" Color="{StaticResource CorNoiteLateral}" />
    <SolidColorBrush x:Key="Ambar" Color="{StaticResource CorAmbar}" />
    <SolidColorBrush x:Key="Azul" Color="{StaticResource CorAzul}" />
    <SolidColorBrush x:Key="Texto" Color="{StaticResource CorTexto}" />
    <SolidColorBrush x:Key="TextoSecundario" Color="{StaticResource CorTextoSecundario}" />
    <SolidColorBrush x:Key="TextoSobreAmbar" Color="{StaticResource CorTextoSobreAmbar}" />
    <SolidColorBrush x:Key="Linha" Color="{StaticResource CorLinha}" />
    <SolidColorBrush x:Key="Borda" Color="{StaticResource CorBorda}" />
    <SolidColorBrush x:Key="Superficie" Color="{StaticResource CorSuperficie}" />
    <SolidColorBrush x:Key="SuperficieHover" Color="{StaticResource CorSuperficieHover}" />
    <SolidColorBrush x:Key="Selecao" Color="{StaticResource CorSelecao}" />
    <!-- Botão secundário: um degrau acima da superfície, para não sumir em cima de um cartão -->
    <SolidColorBrush x:Key="SuperficieBotao" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="SuperficieBotaoHover" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="Foco" Color="{StaticResource CorFoco}" />
    <!-- Menus de contexto (a doca redefine pela aparência; o da bandeja fica com estes) -->
    <SolidColorBrush x:Key="FundoMenu" Color="#E6141416" />
    <SolidColorBrush x:Key="HoverMenu" Color="#29F2B544" />
    <SolidColorBrush x:Key="SeparadorMenu" Color="#17FFFFFF" />
    <!-- Botões em pílula das fichas (a aparência redefine por parte) -->
    <SolidColorBrush x:Key="PilulaFundo" Color="#FFF2F2F2" />
    <SolidColorBrush x:Key="PilulaFundoHover" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PilulaTexto" Color="#FF111111" />
    <SolidColorBrush x:Key="PilulaBorda" Color="#47FFFFFF" />
    <SolidColorBrush x:Key="Perigo" Color="#FFFF8A8A" />
    <SolidColorBrush x:Key="PerigoHover" Color="#29E85454" />

    <LinearGradientBrush x:Key="AmbarGradiente" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF7C766" Offset="0" />
        <GradientStop Color="#FFE39A2B" Offset="1" />
    </LinearGradientBrush>

    <!-- Borda de vidro: filete especular no alto, linha discreta embaixo -->
    <LinearGradientBrush x:Key="BordaVidro" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource CorEspecular}" Offset="0" />
        <GradientStop Color="{StaticResource CorLinha}" Offset="0.35" />
        <GradientStop Color="{StaticResource CorLinha}" Offset="1" />
    </LinearGradientBrush>

    <CornerRadius x:Key="RaioCartao">12</CornerRadius>
    <CornerRadius x:Key="RaioBotao">8</CornerRadius>
    <CornerRadius x:Key="RaioPilula">999</CornerRadius>

    <FontFamily x:Key="FonteTitulo">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="FonteCorpo">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Ícones do Windows: usada nas ilhas, na doca e nos menus (por isso fica nos tokens, que carregam primeiro) -->
    <FontFamily x:Key="FonteIcones">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Movimento (spec do ajuste visual §3.1). As peças em Tema/Efeitos.cs leem estes valores. -->
    <Duration x:Key="DuracaoRapida">0:0:0.12</Duration>
    <Duration x:Key="DuracaoMedia">0:0:0.18</Duration>
    <Duration x:Key="DuracaoLenta">0:0:0.26</Duration>
    <Duration x:Key="DuracaoClique">0:0:0.06</Duration>
    <Duration x:Key="DuracaoBrilho">0:0:0.55</Duration>
    <Duration x:Key="DuracaoNotch">0:0:0.32</Duration>
    <BackEase x:Key="CurvaMola" EasingMode="EaseOut" Amplitude="0.35" />
    <CubicEase x:Key="CurvaSuave" EasingMode="EaseOut" />
</ResourceDictionary>
