<Window x:Class="Vitral.App.JanelaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Vitral.Ui;assembly=Vitral.Ui"
        Title="Vitral" Icon="Recursos/vitral.ico"
        Width="1000" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barra lateral -->
        <DockPanel Grid.Column="0" Margin="12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Bottom" Margin="4,12,4,0">
                <CheckBox x:Name="IniciarComWindows" Content="Iniciar com o Windows"
                          Checked="IniciarComWindows_Mudou" Unchecked="IniciarComWindows_Mudou" />
                <TextBlock Margin="0,10,0,0" Opacity="0.7" FontSize="11" TextWrapping="Wrap">
                    <Run Text="Ativo: " /><Run Text="{Binding PerfilAtivo, TargetNullValue='nenhum', Mode=OneWay}" />
                </TextBlock>
                <TextBlock x:Name="TextoBuild" Opacity="0.7" FontSize="11" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="Desfazer última mudança" Command="{Binding DesfazerCommand}" HorizontalAlignment="Stretch" Margin="0,2" />
                <Button Content="Voltar ao Windows original" Command="{Binding OriginalCommand}" HorizontalAlignment="Stretch" Margin="0,2" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Importar" Command="{Binding ImportarCommand}" Margin="0,0,6,0" />
                <Button Content="Exportar" Command="{Binding ExportarCommand}" />
            </StackPanel>
            <TextBlock DockPanel.Dock="Top" Text="PERFIS" Style="{StaticResource TituloSecao}" Margin="4,0,0,6" />
            <Button DockPanel.Dock="Bottom" Content="+ Novo perfil" Command="{Binding NovoCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
            <ListBox ItemsSource="{Binding Perfis}" SelectedItem="{Binding Selecionado}" />
        </DockPanel>

        <!-- Conteúdo -->
        <Grid Grid.Column="1" Margin="0,12,12,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" FontSize="24" FontWeight="SemiBold" Margin="4,0,0,8"
                       Text="{Binding Selecionado, TargetNullValue='Escolha ou crie um perfil'}" />

            <TabControl Grid.Row="1">
                <TabItem Header="Cores e tema">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16" DataContext="{Binding Editor}" IsEnabled="{Binding DataContext.Selecionado, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TemValor}}">
                            <TextBlock Text="Modo do Windows (barra e Iniciar)" Style="{StaticResource TituloSecao}" />
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ModoSistema}" Width="220" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Não mexer" Tag="{x:Static ui:ModoOpcional.NaoMexer}" />
                                <ComboBoxItem Content="Claro" Tag="{x:Static ui:ModoOpcional.Claro}" />
                                <ComboBoxItem Content="Escuro" Tag="{x:Static ui:ModoOpcional.Escuro}" />
                            </ComboBox>

                            <TextBlock Text="Modo dos aplicativos (janelas)" Style="{StaticResource TituloSecao}" />
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding ModoApps}" Width="220" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Não mexer" Tag="{x:Static ui:ModoOpcional.NaoMexer}" />
                                <ComboBoxItem Content="Claro" Tag="{x:Static ui:ModoOpcional.Claro}" />
                                <ComboBoxItem Content="Escuro" Tag="{x:Static ui:ModoOpcional.Escuro}" />
                            </ComboBox>

                            <TextBlock Text="Cor de destaque" Style="{StaticResource TituloSecao}" />
                            <ItemsControl ItemsSource="{Binding CoresSugeridas}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel MaxWidth="520" HorizontalAlignment="Left" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="28" Height="28" Margin="0,0,6,6" Padding="0" ToolTip="{Binding}"
                                                Command="{Binding DataContext.EscolherCorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Border Background="{Binding}" CornerRadius="4" Width="22" Height="22" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border Width="28" Height="28" CornerRadius="4" BorderThickness="1" BorderBrush="#808080"
                                        Background="{Binding CorDestaque, Converter={StaticResource CorParaPincel}}" />
                                <TextBox Text="{Binding CorDestaque, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="110" Margin="8,0" VerticalContentAlignment="Center" ToolTip="Cor livre no formato #RRGGBB" />
                                <Button Content="Não mexer" Command="{Binding EscolherCorCommand}" CommandParameter="{x:Null}" />
                            </StackPanel>

                            <TextBlock Text="Cor automática pelo papel de parede" Style="{StaticResource TituloSecao}" />
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding CorAutomatica}" Width="220" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Não mexer" Tag="{x:Static ui:Escolha.NaoMexer}" />
                                <ComboBoxItem Content="Ligada" Tag="{x:Static ui:Escolha.Sim}" />
                                <ComboBoxItem Content="Desligada" Tag="{x:Static ui:Escolha.Nao}" />
                            </ComboBox>
                            <TextBlock Text="Escolher uma cor acima desliga a automática." Opacity="0.65" FontSize="11" Margin="0,4,0,0" />

                            <TextBlock Text="Efeitos de transparência" Style="{StaticResource TituloSecao}" />
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Transparencia}" Width="220" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Não mexer" Tag="{x:Static ui:Escolha.NaoMexer}" />
                                <ComboBoxItem Content="Ligados" Tag="{x:Static ui:Escolha.Sim}" />
                                <ComboBoxItem Content="Desligados" Tag="{x:Static ui:Escolha.Nao}" />
                            </ComboBox>

                            <TextBlock Text="Cor de destaque no Iniciar e na barra de tarefas (só no modo escuro)" Style="{StaticResource TituloSecao}" />
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding DestaqueNaBarraEIniciar}" Width="220" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Não mexer" Tag="{x:Static ui:Escolha.NaoMexer}" />
                                <ComboBoxItem Content="Ligada" Tag="{x:Static ui:Escolha.Sim}" />
                                <ComboBoxItem Content="Desligada" Tag="{x:Static ui:Escolha.Nao}" />
                            </ComboBox>

                            <TextBlock Text="Cor de destaque nas barras de título e bordas" Style="{StaticResource TituloSecao}" />
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding DestaqueNosTitulos}" Width="220" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Não mexer" Tag="{x:Static ui:Escolha.NaoMexer}" />
                                <ComboBoxItem Content="Ligada" Tag="{x:Static ui:Escolha.Sim}" />
                                <ComboBoxItem Content="Desligada" Tag="{x:Static ui:Escolha.Nao}" />
                            </ComboBox>

                            <TextBlock Text="Alinhamento da barra de tarefas" Style="{StaticResource TituloSecao}" />
                            <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Alinhamento}" Width="220" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Não mexer" Tag="{x:Static ui:AlinhamentoOpcional.NaoMexer}" />
                                <ComboBoxItem Content="Centro" Tag="{x:Static ui:AlinhamentoOpcional.Centro}" />
                                <ComboBoxItem Content="Esquerda" Tag="{x:Static ui:AlinhamentoOpcional.Esquerda}" />
                            </ComboBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Barra de tarefas" IsEnabled="False" ToolTip="Em breve" />
                <TabItem Header="Iniciar" IsEnabled="False" ToolTip="Em breve" />
                <TabItem Header="Central" IsEnabled="False" ToolTip="Em breve" />
                <TabItem Header="Explorer" IsEnabled="False" ToolTip="Em breve" />
                <TabItem Header="Barra do topo" IsEnabled="False" ToolTip="Em breve" />
                <TabItem Header="Janelas" IsEnabled="False" ToolTip="Em breve" />
            </TabControl>

            <DockPanel Grid.Row="2" Margin="0,10,0,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Salvar" Command="{Binding SalvarPerfilCommand}" Margin="0,0,8,0" />
                    <Button Content="Testar (20 s)" Command="{Binding TestarCommand}" Margin="0,0,8,0" />
                    <Button Content="Aplicar" Command="{Binding AplicarCommand}" Style="{DynamicResource AccentButtonStyle}" />
                </StackPanel>
                <TextBlock Text="{Binding Mensagem}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="4,0,12,0" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
