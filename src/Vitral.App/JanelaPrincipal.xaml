<Window x:Class="Vitral.App.JanelaPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Vitral.Ui;assembly=Vitral.Ui"
        xmlns:local="clr-namespace:Vitral.App"
        Title="Vitral" Icon="Recursos/vitral.ico"
        Width="1040" Height="720" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Foreground="{StaticResource Texto}" FontFamily="{StaticResource FonteCorpo}"
        Background="{StaticResource Noite}">
    <Window.Resources>
        <!-- Campos do "personalizar" da aba Aparência (geral e cada parte do "diferenciar"); contexto: EditorAjustesAparencia -->
        <DataTemplate x:Key="CamposAparencia">
            <StackPanel>
                <TextBlock Text="Material" FontSize="12" Foreground="{StaticResource TextoSecundario}" Margin="0,6,0,4" />
                <ListBox Style="{StaticResource SeletorPilula}" ItemsSource="{x:Static ui:Opcoes.MateriaisAparencia}"
                         SelectedValue="{Binding Material, Converter={StaticResource NuloComoMarca}}" />
                <TextBlock Text="Cor do fundo" FontSize="12" Foreground="{StaticResource TextoSecundario}" Margin="0,10,0,4" />
                <ListBox Style="{StaticResource SeletorCor}" ItemsSource="{x:Static ui:Opcoes.FundosAparencia}"
                         SelectedValue="{Binding CorFundo, Converter={StaticResource NuloComoMarca}}" />
                <DockPanel Margin="0,6,0,4">
                    <TextBlock DockPanel.Dock="Right" FontSize="12" Text="{Binding Transparencia, StringFormat={}{0}%, TargetNullValue='do tema'}" />
                    <TextBlock Text="Transparência" FontSize="12" Foreground="{StaticResource TextoSecundario}" />
                </DockPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="do tema" Click="TransparenciaDoTema_Click" Padding="10,3" FontSize="11.5" Margin="8,0,0,0" ToolTip="Volta à transparência do tema">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource BotaoVidro}">
                                <Style.Triggers><DataTrigger Binding="{Binding Transparencia}" Value="{x:Null}"><Setter Property="Visibility" Value="Hidden" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Slider Minimum="0" Maximum="100" SmallChange="5" LargeChange="10" VerticalAlignment="Center"
                            Value="{Binding Transparencia, Converter={StaticResource TransparenciaNoDeslizante}}">
                        <Slider.Style>
                            <Style TargetType="Slider" BasedOn="{StaticResource DeslizanteVitral}">
                                <Style.Triggers><DataTrigger Binding="{Binding Transparencia}" Value="{x:Null}"><Setter Property="Opacity" Value="0.45" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Slider.Style>
                    </Slider>
                </DockPanel>
                <TextBlock Text="Destaque" FontSize="12" Foreground="{StaticResource TextoSecundario}" Margin="0,10,0,4" />
                <ListBox Style="{StaticResource SeletorCor}" ItemsSource="{x:Static ui:Opcoes.DestaquesAparencia}"
                         SelectedValue="{Binding CorDestaque, Converter={StaticResource NuloComoMarca}}" />
                <TextBlock Text="Cantos" FontSize="12" Foreground="{StaticResource TextoSecundario}" Margin="0,8,0,4" />
                <ListBox Style="{StaticResource SeletorPilula}" ItemsSource="{x:Static ui:Opcoes.CantosAparencia}"
                         SelectedValue="{Binding Cantos, Converter={StaticResource NuloComoMarca}}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barra lateral -->
        <Border Grid.Column="0" Background="{StaticResource NoiteLateral}" BorderBrush="{StaticResource Linha}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,10,14,14" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,8">
                    <Image Source="{StaticResource Logo}" Width="24" Height="24" />
                    <TextBlock Text="Vitral" FontFamily="{StaticResource FonteTitulo}" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="4,10,4,0">
                    <CheckBox x:Name="IniciarComWindows" Content="Iniciar com o Windows" Foreground="{StaticResource Texto}"
                              FocusVisualStyle="{StaticResource FocoVitral}"
                              Checked="IniciarComWindows_Mudou" Unchecked="IniciarComWindows_Mudou" />
                    <!-- Avisos do Claude Code no notch (spec do notch vivo §4.6): liga os ganchos no settings.json do Claude -->
                    <CheckBox x:Name="AvisosClaude" Content="Avisos do Claude no notch" Foreground="{StaticResource Texto}" Margin="0,6,0,0"
                              FocusVisualStyle="{StaticResource FocoVitral}"
                              Checked="AvisosClaude_Mudou" Unchecked="AvisosClaude_Mudou" />
                    <TextBlock x:Name="TextoBuild" Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource TextoSecundario}" />
                    <!-- Versão e atualização automática (spec da atualização §5.4) -->
                    <TextBlock x:Name="TextoVersao" Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource TextoSecundario}" />
                    <TextBlock x:Name="LinhaAtualizacao" Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextoSecundario}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="Desfazer última mudança" Command="{Binding DesfazerCommand}" Style="{StaticResource BotaoVidro}" HorizontalContentAlignment="Left" Margin="0,3" />
                    <Button Content="Voltar ao Windows original" Command="{Binding OriginalCommand}" Style="{StaticResource BotaoVidro}" HorizontalContentAlignment="Left" Margin="0,3" />
                </StackPanel>
                <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,10,0,0">
                    <Button Content="Importar" Command="{Binding ImportarCommand}" Style="{StaticResource BotaoVidro}" Margin="0,0,3,0" />
                    <Button Content="Exportar" Command="{Binding ExportarCommand}" Style="{StaticResource BotaoVidro}" Margin="3,0,0,0" />
                </UniformGrid>
                <Button DockPanel.Dock="Bottom" Content="+ Novo perfil" Command="{Binding NovoCommand}" Style="{StaticResource BotaoVidro}" Margin="0,8,0,0" />

                <TextBlock DockPanel.Dock="Top" Text="PERFIS" Style="{StaticResource Rotulo}" />
                <ListBox ItemsSource="{Binding ItensPerfis}" SelectedValuePath="Nome" SelectedValue="{Binding Selecionado}"
                         Style="{StaticResource ListaPerfis}" ItemContainerStyle="{StaticResource ItemListaPerfil}" />
            </DockPanel>
        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Column="1" Margin="28,14,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" FontFamily="{StaticResource FonteTitulo}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,10"
                       Text="{Binding Selecionado, TargetNullValue='Escolha ou crie um perfil'}" />

            <TabControl Grid.Row="1" Style="{StaticResource AbasVitral}">
                <TabItem Header="Cores e tema" Style="{StaticResource AbaVitral}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel DataContext="{Binding Editor}"
                                    IsEnabled="{Binding DataContext.Selecionado, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TemValor}}">
                            <!-- Sem perfil escolhido, o editor todo fica apagado (pílulas e cores não têm estado desabilitado próprio) -->
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <Border Style="{StaticResource CartaoVidro}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Text="Modo do Windows (barra e Iniciar)" VerticalAlignment="Center" />
                                    <ListBox Grid.Column="1" Style="{StaticResource SeletorPilula}" ItemsSource="{x:Static ui:Opcoes.Modos}" SelectedValue="{Binding ModoSistema}" />
                                    <TextBlock Grid.Row="1" Text="Modo dos aplicativos" VerticalAlignment="Center" Margin="0,12,0,0" />
                                    <ListBox Grid.Row="1" Grid.Column="1" Style="{StaticResource SeletorPilula}" Margin="0,12,0,0" ItemsSource="{x:Static ui:Opcoes.Modos}" SelectedValue="{Binding ModoApps}" />
                                    <TextBlock Grid.Row="2" Text="Efeitos de transparência" VerticalAlignment="Center" Margin="0,12,0,0" />
                                    <ListBox Grid.Row="2" Grid.Column="1" Style="{StaticResource SeletorPilula}" Margin="0,12,0,0" ItemsSource="{x:Static ui:Opcoes.Ligada}" SelectedValue="{Binding Transparencia}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CartaoVidro}">
                                <StackPanel>
                                    <TextBlock Text="Cor de destaque" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding CoresSugeridas}" Focusable="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel MaxWidth="560" HorizontalAlignment="Left" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource BotaoCor}" ToolTip="{Binding}" CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.EscolherCorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Width="30" Height="30" CornerRadius="8" BorderBrush="{StaticResource Borda}" BorderThickness="1"
                                                Background="{Binding CorDestaque, Converter={StaticResource CorParaPincel}}" />
                                        <TextBox Text="{Binding CorDestaque, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="110" Margin="10,0"
                                                 Style="{StaticResource CaixaVidro}" ToolTip="Cor livre no formato #RRGGBB" />
                                        <Button Content="Não mexer" Command="{Binding EscolherCorCommand}" CommandParameter="{x:Null}" Style="{StaticResource BotaoVidro}" />
                                    </StackPanel>
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Cor automática pelo papel de parede" VerticalAlignment="Center" />
                                        <ListBox Grid.Column="1" Style="{StaticResource SeletorPilula}" ItemsSource="{x:Static ui:Opcoes.Ligada}" SelectedValue="{Binding CorAutomatica}" />
                                    </Grid>
                                    <TextBlock Text="Escolher uma cor acima desliga a automática." FontSize="11" Foreground="{StaticResource TextoSecundario}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CartaoVidro}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Text="Destaque no Iniciar e na barra (só no modo escuro)" VerticalAlignment="Center" />
                                    <ListBox Grid.Column="1" Style="{StaticResource SeletorPilula}" ItemsSource="{x:Static ui:Opcoes.Ligada}" SelectedValue="{Binding DestaqueNaBarraEIniciar}" />
                                    <TextBlock Grid.Row="1" Text="Destaque nas barras de título e bordas" VerticalAlignment="Center" Margin="0,12,0,0" />
                                    <ListBox Grid.Row="1" Grid.Column="1" Style="{StaticResource SeletorPilula}" Margin="0,12,0,0" ItemsSource="{x:Static ui:Opcoes.Ligada}" SelectedValue="{Binding DestaqueNosTitulos}" />
                                    <TextBlock Grid.Row="2" Text="Alinhamento da barra de tarefas" VerticalAlignment="Center" Margin="0,12,0,0" />
                                    <ListBox Grid.Row="2" Grid.Column="1" Style="{StaticResource SeletorPilula}" Margin="0,12,0,0" ItemsSource="{x:Static ui:Opcoes.Alinhamentos}" SelectedValue="{Binding Alinhamento}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Barra de tarefas" Style="{StaticResource AbaVitral}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel DataContext="{Binding EditorBarraTarefas}"
                                    IsEnabled="{Binding DataContext.Selecionado, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TemValor}}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- Doca do Vitral (seção barraBaixo do perfil) -->
                            <Border Style="{StaticResource CartaoVidro}" DataContext="{Binding DataContext.EditorDoca, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Doca do Vitral" VerticalAlignment="Center" />
                                        <ListBox Grid.Column="1" Style="{StaticResource SeletorPilula}" ItemsSource="{x:Static ui:Opcoes.Ligada}" SelectedValue="{Binding Doca}" />
                                    </Grid>
                                    <TextBlock Text="Esconde a barra do Windows e mostra a doca do Vitral. Os ícones dos apps passam para a setinha da barra do topo."
                                               FontSize="11" Foreground="{StaticResource TextoSecundario}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CartaoVidro}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Text="Pesquisa" VerticalAlignment="Center" />
                                    <ListBox Grid.Column="1" Style="{StaticResource SeletorPilula}" ItemsSource="{x:Static ui:Opcoes.Pesquisas}" SelectedValue="{Binding Pesquisa}" />
                                    <TextBlock Grid.Row="1" Text="Visão de tarefas" VerticalAlignment="Center" Margin="0,12,0,0" />
                                    <ListBox Grid.Row="1" Grid.Column="1" Style="{StaticResource SeletorPilula}" Margin="0,12,0,0" ItemsSource="{x:Static ui:Opcoes.Escolhas}" SelectedValue="{Binding VisaoTarefas}" />
                                    <TextBlock Grid.Row="2" Text="Mostrar área de trabalho no canto" VerticalAlignment="Center" Margin="0,12,0,0" />
                                    <ListBox Grid.Row="2" Grid.Column="1" Style="{StaticResource SeletorPilula}" Margin="0,12,0,0" ItemsSource="{x:Static ui:Opcoes.Escolhas}" SelectedValue="{Binding MostrarAreaDeTrabalho}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CartaoVidro}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Text="Agrupar botões" VerticalAlignment="Center" />
                                    <ListBox Grid.Column="1" Style="{StaticResource SeletorPilula}" ItemsSource="{x:Static ui:Opcoes.Agrupamentos}" SelectedValue="{Binding Agrupar}" />
                                    <TextBlock Grid.Row="1" Text="Ocultar automaticamente" VerticalAlignment="Center" Margin="0,12,0,0" />
                                    <ListBox Grid.Row="1" Grid.Column="1" Style="{StaticResource SeletorPilula}" Margin="0,12,0,0" ItemsSource="{x:Static ui:Opcoes.Escolhas}" SelectedValue="{Binding OcultarAutomaticamente}" />
                                    <TextBlock Grid.Row="2" Text="Barra em todos os monitores" VerticalAlignment="Center" Margin="0,12,0,0" />
                                    <ListBox Grid.Row="2" Grid.Column="1" Style="{StaticResource SeletorPilula}" Margin="0,12,0,0" ItemsSource="{x:Static ui:Opcoes.Escolhas}" SelectedValue="{Binding TodosOsMonitores}" />
                                    <TextBlock Grid.Row="3" Text="Selos nos ícones" VerticalAlignment="Center" Margin="0,12,0,0" />
                                    <ListBox Grid.Row="3" Grid.Column="1" Style="{StaticResource SeletorPilula}" Margin="0,12,0,0" ItemsSource="{x:Static ui:Opcoes.Escolhas}" SelectedValue="{Binding Selos}" />
                                    <TextBlock Grid.Row="4" Text="Piscar ao pedir atenção" VerticalAlignment="Center" Margin="0,12,0,0" />
                                    <ListBox Grid.Row="4" Grid.Column="1" Style="{StaticResource SeletorPilula}" Margin="0,12,0,0" ItemsSource="{x:Static ui:Opcoes.Escolhas}" SelectedValue="{Binding Piscar}" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource CartaoVidro}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Ícones perto do relógio" VerticalAlignment="Center" />
                                        <ListBox Grid.Column="1" Style="{StaticResource SeletorPilula}" ItemsSource="{x:Static ui:Opcoes.EscolherIcones}" SelectedValue="{Binding EscolherIcones}" />
                                    </Grid>
                                    <TextBlock Text="Marcados ficam à mostra; os outros vão para a setinha ^." FontSize="11" Foreground="{StaticResource TextoSecundario}" Margin="0,6,0,8" />
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Icones}" Focusable="False">
                                            <ItemsControl.Style>
                                                <Style TargetType="ItemsControl">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EscolherIcones}" Value="{x:Static ui:Escolha.Sim}"><Setter Property="IsEnabled" Value="True" /></DataTrigger>
                                                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ItemsControl.Style>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Nome}" IsChecked="{Binding Visivel}" Foreground="{StaticResource Texto}"
                                                              FocusVisualStyle="{StaticResource FocoVitral}" Margin="0,3" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Transparência da barra: TranslucentTB. Com a barra do topo ligada, o relógio daqui some."
                                       FontSize="11" Foreground="{StaticResource TextoSecundario}" TextWrapping="Wrap" Margin="4,4,0,8" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Iniciar" Style="{StaticResource AbaVitral}" IsEnabled="False" />
                <TabItem Header="Barra do topo" Style="{StaticResource AbaVitral}">
                    <StackPanel DataContext="{Binding EditorBarra}"
                                IsEnabled="{Binding DataContext.Selecionado, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TemValor}}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Style="{StaticResource CartaoVidro}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Barra do topo" VerticalAlignment="Center" />
                                    <ListBox Grid.Column="1" Style="{StaticResource SeletorPilula}" ItemsSource="{x:Static ui:Opcoes.Ligada}" SelectedValue="{Binding Barra}" />
                                </Grid>
                                <TextBlock Text="Três ilhas de vidro no topo do monitor principal, com espaço reservado para as janelas não ficarem embaixo."
                                           FontSize="11" Foreground="{StaticResource TextoSecundario}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CartaoVidro}" IsEnabled="{Binding IlhasHabilitadas}">
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Ilhas" Margin="0,0,0,8" />
                                <CheckBox Content="Mídia tocando" IsChecked="{Binding Midia}" Foreground="{StaticResource Texto}" FocusVisualStyle="{StaticResource FocoVitral}" Margin="0,4" />
                                <CheckBox Content="Relógio" IsChecked="{Binding Relogio}" Foreground="{StaticResource Texto}" FocusVisualStyle="{StaticResource FocoVitral}" Margin="0,4" />
                                <CheckBox Content="Status (rede, volume, bateria)" IsChecked="{Binding Status}" Foreground="{StaticResource Texto}" FocusVisualStyle="{StaticResource FocoVitral}" Margin="0,4" />
                                <CheckBox Content="CPU e memória" IsChecked="{Binding Desempenho}" Foreground="{StaticResource Texto}" FocusVisualStyle="{StaticResource FocoVitral}" Margin="0,4" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
                <!-- Aparência da doca, do notch e das ilhas (spec da aparência §5.4) -->
                <TabItem Header="Aparência" Style="{StaticResource AbaVitral}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <Grid DataContext="{Binding EditorAparencia}"
                              IsEnabled="{Binding DataContext.Selecionado, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TemValor}}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="TEMA DA DOCA, DO NOTCH E DAS ILHAS" Style="{StaticResource Rotulo}" Margin="2,4,0,8" />
                                <ListBox Style="{StaticResource GradeTemas}" ItemsSource="{x:Static ui:Opcoes.TemasAparencia}"
                                         SelectedValue="{Binding Tema, Converter={StaticResource NuloComoMarca}}" />
                                <local:PreviaAparencia Valores="{Binding Previa}" Height="230" Margin="0,6,8,0"
                                                       Formas="{Binding DataContext.EditorFormas.Previa, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <TextBlock Text="A prévia usa o seu papel de parede. Para ver de verdade, use Testar (20 s)."
                                           FontSize="11" Foreground="{StaticResource TextoSecundario}" TextWrapping="Wrap" Margin="2,6,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <!-- Sem tema ("Não mexer"), o personalizar não vale nada: fica apagado -->
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tema}" Value="{x:Null}">
                                                <Setter Property="IsEnabled" Value="False" />
                                                <Setter Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Style="{StaticResource CartaoVidro}">
                                    <StackPanel>
                                        <TextBlock Text="PERSONALIZAR (OPCIONAL)" Style="{StaticResource Rotulo}" Margin="0,0,0,2" />
                                        <ContentControl Content="{Binding Geral}" ContentTemplate="{StaticResource CamposAparencia}" Focusable="False" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CartaoVidro}">
                                    <StackPanel>
                                        <TextBlock Text="DIFERENCIAR" Style="{StaticResource Rotulo}" Margin="0,0,0,4" />
                                        <CheckBox Content="Doca" IsChecked="{Binding Doca.Diferenciar}" Foreground="{StaticResource Texto}" FocusVisualStyle="{StaticResource FocoVitral}" Margin="0,4" />
                                        <ContentControl Content="{Binding Doca}" ContentTemplate="{StaticResource CamposAparencia}" Focusable="False" Margin="22,0,0,10"
                                                        Visibility="{Binding Doca.Diferenciar, Converter={StaticResource BoolParaVisivel}}" />
                                        <CheckBox Content="Notch" IsChecked="{Binding Notch.Diferenciar}" Foreground="{StaticResource Texto}" FocusVisualStyle="{StaticResource FocoVitral}" Margin="0,4" />
                                        <ContentControl Content="{Binding Notch}" ContentTemplate="{StaticResource CamposAparencia}" Focusable="False" Margin="22,0,0,10"
                                                        Visibility="{Binding Notch.Diferenciar, Converter={StaticResource BoolParaVisivel}}" />
                                        <CheckBox Content="Ilhas e painéis" IsChecked="{Binding Ilhas.Diferenciar}" Foreground="{StaticResource Texto}" FocusVisualStyle="{StaticResource FocoVitral}" Margin="0,4" />
                                        <ContentControl Content="{Binding Ilhas}" ContentTemplate="{StaticResource CamposAparencia}" Focusable="False" Margin="22,0,0,10"
                                                        Visibility="{Binding Ilhas.Diferenciar, Converter={StaticResource BoolParaVisivel}}" />
                                        <TextBlock Text="Marcar abre os mesmos campos só para aquela parte; o resto segue o geral."
                                                   FontSize="11" Foreground="{StaticResource TextoSecundario}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <!-- Formas da doca, do notch e das ilhas (spec das formas §5.4) -->
                <TabItem Header="Formas" Style="{StaticResource AbaVitral}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <Grid DataContext="{Binding EditorFormas}"
                              IsEnabled="{Binding DataContext.Selecionado, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource TemValor}}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger></Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="350" /></Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="PRÉVIA" Style="{StaticResource Rotulo}" Margin="2,4,0,8" />
                                <local:PreviaAparencia Formas="{Binding Previa}" SemValoresUsaAtual="True" Height="260" Margin="0,0,8,0"
                                                       Valores="{Binding DataContext.EditorAparencia.Previa, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <TextBlock Text="Com as cores da aba Aparência. Para ver de verdade, use Testar (20 s)."
                                           FontSize="11" Foreground="{StaticResource TextoSecundario}" TextWrapping="Wrap" Margin="2,6,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource CartaoVidro}">
                                    <StackPanel>
                                        <TextBlock Text="DOCA" Style="{StaticResource Rotulo}" Margin="0,0,0,2" />
                                        <TextBlock Text="Formato" FontSize="12" Foreground="{StaticResource TextoSecundario}" Margin="0,6,0,4" />
                                        <ListBox Style="{StaticResource SeletorPilula}" ItemsSource="{x:Static ui:Opcoes.FormatosDoca}"
                                                 SelectedValue="{Binding FormatoDoca, Converter={StaticResource NuloComoMarca}}" />
                                        <TextBlock Text="Ícones" FontSize="12" Foreground="{StaticResource TextoSecundario}" Margin="0,10,0,4" />
                                        <ListBox Style="{StaticResource SeletorPilula}" ItemsSource="{x:Static ui:Opcoes.IconesDoca}"
                                                 SelectedValue="{Binding IconesDoca, Converter={StaticResource NuloComoMarca}}" />
                                        <TextBlock Text="Ampliação ao passar o mouse" FontSize="12" Foreground="{StaticResource TextoSecundario}" Margin="0,10,0,4" />
                                        <ListBox Style="{StaticResource SeletorPilula}" ItemsSource="{x:Static ui:Opcoes.Ampliacoes}"
                                                 SelectedValue="{Binding AmpliacaoDoca, Converter={StaticResource NuloComoMarca}}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CartaoVidro}">
                                    <StackPanel>
                                        <TextBlock Text="NOTCH" Style="{StaticResource Rotulo}" Margin="0,0,0,2" />
                                        <TextBlock Text="Formato" FontSize="12" Foreground="{StaticResource TextoSecundario}" Margin="0,6,0,4" />
                                        <ListBox Style="{StaticResource SeletorPilula}" ItemsSource="{x:Static ui:Opcoes.FormatosNotch}"
                                                 SelectedValue="{Binding FormatoNotch, Converter={StaticResource NuloComoMarca}}" />
                                        <TextBlock Text="Tamanho" FontSize="12" Foreground="{StaticResource TextoSecundario}" Margin="0,10,0,4" />
                                        <ListBox Style="{StaticResource SeletorPilula}" ItemsSource="{x:Static ui:Opcoes.TamanhosNotch}"
                                                 SelectedValue="{Binding TamanhoNotch, Converter={StaticResource NuloComoMarca}}" />
                                        <TextBlock Text="O arredondamento segue os cantos da aba Aparência." FontSize="11" Foreground="{StaticResource TextoSecundario}"
                                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CartaoVidro}">
                                    <StackPanel>
                                        <TextBlock Text="ILHAS" Style="{StaticResource Rotulo}" Margin="0,0,0,2" />
                                        <TextBlock Text="Disposição" FontSize="12" Foreground="{StaticResource TextoSecundario}" Margin="0,6,0,4" />
                                        <ListBox Style="{StaticResource SeletorPilula}" ItemsSource="{x:Static ui:Opcoes.DisposicoesIlhas}"
                                                 SelectedValue="{Binding DisposicaoIlhas, Converter={StaticResource NuloComoMarca}}" />
                                        <TextBlock Text="Distância da borda" FontSize="12" Foreground="{StaticResource TextoSecundario}" Margin="0,10,0,4" />
                                        <ListBox Style="{StaticResource SeletorPilula}" ItemsSource="{x:Static ui:Opcoes.DistanciasIlhas}"
                                                 SelectedValue="{Binding DistanciaIlhas, Converter={StaticResource NuloComoMarca}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Janelas" Style="{StaticResource AbaVitral}" IsEnabled="False" />
            </TabControl>

            <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Descartar" Command="{Binding DescartarCommand}" Style="{StaticResource BotaoVidro}" Margin="0,0,8,0" />
                    <Button Content="Salvar" Command="{Binding SalvarPerfilCommand}" Style="{StaticResource BotaoVidro}" Margin="0,0,8,0" />
                    <Button Content="Testar (20 s)" Command="{Binding TestarCommand}" Style="{StaticResource BotaoVidro}" Margin="0,0,8,0" />
                    <Button Content="Aplicar" Command="{Binding AplicarCommand}" Style="{StaticResource BotaoPrimario}" />
                </StackPanel>
                <TextBlock Text="{Binding Mensagem}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextoSecundario}" Margin="0,0,16,0" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
