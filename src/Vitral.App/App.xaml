<Application x:Class="Vitral.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Vitral.App"
             ThemeMode="System"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <local:CorParaPincel x:Key="CorParaPincel" />
        <local:TemValor x:Key="TemValor" />
        <Style x:Key="TituloSecao" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
    </Application.Resources>
</Application>
