<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- APIs WinRT da barra do topo (mídia, rede, bateria) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- O TasksService da ManagedShell usa o System.Windows.Forms (NativeWindow): sem isto o instalador, que leva o
         .NET junto, fica sem a DLL e a doca perde a bandeja e as janelas. Só a referência, sem os usings implícitos. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- O DPI do manifesto é do WPF; o aviso do WinForms (WFO0003) não se aplica -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyName>Vitral</AssemblyName>
    <RootNamespace>Vitral.App</RootNamespace>
    <ApplicationIcon>Recursos\vitral.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.7.1</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- ThemeMode (Fluent) ainda é marcado como experimental no WPF -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Token de leitura das releases (spec da atualização §3): o build.ps1 passa -p:TokenAtualizacao a partir da variável
       VITRAL_TOKEN_ATUALIZACAO; sem ela (builds de desenvolvimento), não há token e a atualização fica desligada. -->
  <ItemGroup Condition="'$(TokenAtualizacao)' != ''">
    <AssemblyMetadata Include="TokenAtualizacao" Value="$(TokenAtualizacao)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Main próprio (Program.cs) para o Velopack rodar antes do WPF -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Recursos\vitral.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vitral.Core\Vitral.Core.csproj" />
    <ProjectReference Include="..\Vitral.Ui\Vitral.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- Bandeja de ícones e lista de janelas da doca (Apache-2.0, ver THIRD-PARTY-NOTICES.md) -->
    <PackageReference Include="ManagedShell" Version="0.0.374" />
  </ItemGroup>

</Project>
