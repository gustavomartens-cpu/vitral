<UserControl x:Class="Vitral.App.Barra.PainelVolume"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Painel de volume (spec v2 §3.3). DataContext: PainelVolumeViewModel. -->
    <StackPanel>
        <TextBlock Text="VOLUME" Style="{StaticResource TituloPainel}" />
        <StackPanel IsEnabled="{Binding Disponivel}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding AlternarMudoCommand}" Style="{StaticResource LinhaPainel}" HorizontalContentAlignment="Center">
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Mudo" />
                                <Setter Property="Foreground" Value="{StaticResource TextoSecundario}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mudo}" Value="True">
                                        <Setter Property="Text" Value="Mudo ●" />
                                        <Setter Property="Foreground" Value="{StaticResource Ambar}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource FonteIcones}" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Volume}" FontSize="14" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
            <Slider Style="{StaticResource DeslizanteVidro}" Minimum="0" Maximum="100" SmallChange="2" LargeChange="10"
                    Value="{Binding Volume, Mode=TwoWay}" Margin="0,8,0,12" />
        </StackPanel>

        <StackPanel Visibility="{Binding MostrarSaidas, Converter={StaticResource BoolParaVisivel}}">
            <TextBlock Text="SAÍDA" Style="{StaticResource TituloPainel}" />
            <ItemsControl ItemsSource="{Binding Saidas}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource LinhaPainel}" Margin="0,1"
                                Command="{Binding DataContext.EscolherCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                            <DockPanel>
                                <TextBlock x:Name="Marca" DockPanel.Dock="Right" Text="●" Foreground="{StaticResource Ambar}" Visibility="Collapsed" />
                                <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Button>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Padrao}" Value="True"><Setter TargetName="Marca" Property="Visibility" Value="Visible" /></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
