<UserControl x:Class="Vitral.App.Barra.PainelControles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Name="Raiz">
    <!-- Painel de controles (spec dos controles §3). DataContext: PainelControlesViewModel. -->
    <UserControl.Resources>
        <sys:Boolean x:Key="Ligado">True</sys:Boolean>
        <!-- Bloco da grade: Tag = estado (True aceso, False apagado, nulo = o Windows recusou e o bloco fica desligado) -->
        <Style x:Key="BlocoControle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVitral}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" Background="{DynamicResource Superficie}" BorderBrush="{DynamicResource Borda}" BorderThickness="1"
                                CornerRadius="10" Padding="10,8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="Background" Value="{DynamicResource SuperficieHover}" /></Trigger>
                            <Trigger Property="Tag" Value="{StaticResource Ligado}">
                                <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource Selecao}" />
                                <Setter TargetName="Fundo" Property="BorderBrush" Value="{DynamicResource Ambar}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="{x:Null}"><Setter Property="Opacity" Value="0.45" /><Setter Property="IsEnabled" Value="False" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconeBloco" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FonteIcones}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="EstadoBloco" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextoSecundario}" />
            <Setter Property="Text" Value="Desligado" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" Value="{StaticResource Ligado}">
                    <Setter Property="Text" Value="Ligado" />
                    <Setter Property="Foreground" Value="{DynamicResource Ambar}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A dica do teclado no Bluetooth e no Modo avião -->
        <Style x:Key="ComAvisoTeclado" TargetType="Button" BasedOn="{StaticResource BlocoControle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding AvisoTeclado}" Value="True">
                    <Setter Property="ToolTip" Value="O teclado e o mouse Bluetooth desconectam enquanto estiver desligado" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="CONTROLES" Style="{StaticResource TituloPainel}" />

        <UniformGrid Columns="2">
            <!-- Bluetooth, com a seta da lista dos aparelhos -->
            <Grid Margin="0,0,3,6">
                <Button Style="{StaticResource ComAvisoTeclado}" Tag="{Binding Bluetooth}" Command="{Binding AlternarBluetoothCommand}">
                    <StackPanel>
                        <TextBlock Text="&#xE702;" Style="{StaticResource IconeBloco}" />
                        <TextBlock Text="Bluetooth" />
                        <TextBlock Style="{StaticResource EstadoBloco}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource LinhaPainel}" Command="{Binding AlternarAparelhosCommand}" ToolTip="Aparelhos Bluetooth"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" Padding="0">
                    <TextBlock FontFamily="{StaticResource FonteIcones}" FontSize="10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE70D;" />
                                <Style.Triggers><DataTrigger Binding="{Binding MostrarAparelhos}" Value="True"><Setter Property="Text" Value="&#xE70E;" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </Grid>
            <Button Style="{StaticResource ComAvisoTeclado}" Tag="{Binding Aviao}" Command="{Binding AlternarAviaoCommand}" Margin="3,0,0,6">
                <StackPanel>
                    <TextBlock Text="&#xE709;" Style="{StaticResource IconeBloco}" />
                    <TextBlock Text="Modo avião" />
                    <TextBlock Style="{StaticResource EstadoBloco}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource BlocoControle}" Tag="{Binding NaoPerturbe}" Command="{Binding AlternarNaoPerturbeCommand}" Margin="0,0,3,0">
                <StackPanel>
                    <TextBlock Text="&#xE708;" Style="{StaticResource IconeBloco}" />
                    <TextBlock Text="Não perturbe" />
                    <TextBlock Style="{StaticResource EstadoBloco}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource BlocoControle}" Tag="{Binding LuzNoturna}" Command="{Binding AlternarLuzNoturnaCommand}" Margin="3,0,0,0"
                    ToolTip="{Binding TextoLuzNoturna}">
                <StackPanel>
                    <TextBlock Text="&#xF08C;" Style="{StaticResource IconeBloco}" />
                    <TextBlock Text="Luz noturna" />
                    <TextBlock Style="{StaticResource EstadoBloco}" />
                </StackPanel>
            </Button>
        </UniformGrid>

        <!-- Aparelhos Bluetooth pareados -->
        <ItemsControl ItemsSource="{Binding Aparelhos}" Focusable="False" Margin="0,8,0,0"
                      Visibility="{Binding MostrarAparelhos, Converter={StaticResource BoolParaVisivel}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource LinhaPainel}" Margin="0,1"
                            Command="{Binding DataContext.AparelhoCommand, ElementName=Raiz}" CommandParameter="{Binding}">
                        <DockPanel>
                            <TextBlock x:Name="Estado" DockPanel.Dock="Right" Text="desconectado" FontSize="11"
                                       Foreground="{DynamicResource TextoSecundario}" VerticalAlignment="Center" />
                            <TextBlock x:Name="Icone" Text="&#xE702;" FontFamily="{StaticResource FonteIcones}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Nome}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tipo}" Value="Audio"><Setter TargetName="Icone" Property="Text" Value="&#xE7F6;" /></DataTrigger>
                        <DataTrigger Binding="{Binding Tipo}" Value="Teclado"><Setter TargetName="Icone" Property="Text" Value="&#xE765;" /></DataTrigger>
                        <DataTrigger Binding="{Binding Tipo}" Value="Mouse"><Setter TargetName="Icone" Property="Text" Value="&#xE962;" /></DataTrigger>
                        <DataTrigger Binding="{Binding Tipo}" Value="Celular"><Setter TargetName="Icone" Property="Text" Value="&#xE8EA;" /></DataTrigger>
                        <DataTrigger Binding="{Binding Tipo}" Value="Controle"><Setter TargetName="Icone" Property="Text" Value="&#xE7FC;" /></DataTrigger>
                        <DataTrigger Binding="{Binding Conectado}" Value="True">
                            <Setter TargetName="Estado" Property="Text" Value="conectado" />
                            <Setter TargetName="Estado" Property="Foreground" Value="{DynamicResource Ambar}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Brilho: um deslizante por tela que aceita -->
        <StackPanel Margin="0,12,0,0">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers><DataTrigger Binding="{Binding Telas.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="BRILHO" Style="{StaticResource TituloPainel}" />
            <ItemsControl ItemsSource="{Binding Telas}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,6">
                            <DockPanel>
                                <TextBlock Text="&#xE706;" FontFamily="{StaticResource FonteIcones}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Nome}" FontSize="11" Foreground="{DynamicResource TextoSecundario}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                            <Slider Style="{StaticResource DeslizanteVidro}" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                    Value="{Binding Valor, Mode=OneTime}" ValueChanged="Brilho_Mudou" Margin="0,4,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
