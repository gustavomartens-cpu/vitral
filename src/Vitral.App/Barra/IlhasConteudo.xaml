<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:barra="clr-namespace:Vitral.App.Barra">
    <!-- Conteúdo das ilhas da barra do topo (spec §3.1). O DataContext é o ViewModel de cada ilha. -->
    <barra:RedeParaIcone x:Key="RedeParaIcone" />
    <barra:BytesParaImagem x:Key="BytesParaImagem" />
    <barra:LarguraPreenchida x:Key="LarguraPreenchida" />
    <barra:SinalParaIcone x:Key="SinalParaIcone" />
    <barra:MesmoObjeto x:Key="MesmoObjeto" />
    <FontFamily x:Key="FonteIcones">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="BotaoIlha" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="FontFamily" Value="{StaticResource FonteIcones}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fundo" Background="Transparent" CornerRadius="6" Width="22" Height="22">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="Background" Value="{StaticResource SuperficieHover}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Painéis (spec v2): rótulo de seção, linha clicável e controle deslizante -->
    <Style x:Key="TituloPainel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextoSecundario}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Margin" Value="0,2,0,8" />
    </Style>

    <Style x:Key="LinhaPainel" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Texto}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVitral}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fundo" Background="Transparent" CornerRadius="8" Padding="8,7">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="Background" Value="{StaticResource SuperficieHover}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DeslizanteVidro" TargetType="Slider">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVitral}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <!-- Trilho desenhado atrás do Track; os botões de repetição só capturam o clique -->
                    <Grid x:Name="Fundo" Height="20" Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource Linha}" />
                        <Border Height="4" CornerRadius="2" HorizontalAlignment="Left" Background="{StaticResource AmbarGradiente}">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource LarguraPreenchida}">
                                    <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="ActualWidth" ElementName="Fundo" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="Diminuir" Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate><Ellipse Width="14" Height="14" Fill="{StaticResource Texto}" /></ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chave liga/desliga: âmbar ligada, apagada desligada -->
    <Style x:Key="ChaveVidro" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocoVitral}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Trilho" Width="32" Height="18" CornerRadius="9" Background="{StaticResource Linha}"
                            BorderBrush="{StaticResource Borda}" BorderThickness="1">
                        <Ellipse x:Name="Bolinha" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left" Fill="{StaticResource Texto}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Trilho" Property="Background" Value="{StaticResource Ambar}" />
                            <Setter TargetName="Bolinha" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Bolinha" Property="Fill" Value="{StaticResource TextoSobreAmbar}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mini barra âmbar com a porcentagem (CPU, MEM) -->
    <DataTemplate x:Key="MiniBarra">
        <Grid Width="22" Height="4" VerticalAlignment="Center">
            <Border Background="{StaticResource Linha}" CornerRadius="2" />
            <Border Background="{StaticResource Ambar}" CornerRadius="2" HorizontalAlignment="Left" Width="22" RenderTransformOrigin="0,0.5">
                <Border.RenderTransform><ScaleTransform ScaleX="{Binding}" /></Border.RenderTransform>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
