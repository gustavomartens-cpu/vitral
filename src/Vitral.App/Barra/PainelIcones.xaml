<UserControl x:Class="Vitral.App.Barra.PainelIcones"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Ícones dos apps (spec da doca §7). DataContext: PainelIconesViewModel. -->
    <StackPanel>
        <TextBlock Text="ÍCONES DOS APPS" Style="{StaticResource TituloPainel}" />
        <ItemsControl ItemsSource="{Binding Icones}" Focusable="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="Fundo" Width="38" Height="38" CornerRadius="8" Background="Transparent" Cursor="Hand"
                            ToolTip="{Binding Titulo}" MouseUp="Icone_Clique">
                        <Image Source="{Binding Imagem}" Width="18" Height="18" />
                    </Border>
                    <DataTemplate.Triggers>
                        <Trigger SourceName="Fundo" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fundo" Property="Background" Value="{DynamicResource SuperficieHover}" />
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
