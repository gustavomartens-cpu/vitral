<UserControl x:Class="Vitral.App.Barra.IlhaStatus"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Cada item clicável é uma pílula (ItemIlha): clara no hover, afunda no clique -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- CPU e MEM -->
        <Border Style="{StaticResource ItemIlha}" ToolTip="Gerenciador de Tarefas" MouseLeftButtonUp="Desempenho_Clique" Margin="0,0,2,0"
                Visibility="{Binding MostrarDesempenho, Converter={StaticResource BoolParaVisivel}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="CPU" Foreground="{DynamicResource TextoSecundario}" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0" />
                <ContentPresenter Content="{Binding CpuFracao}" ContentTemplate="{StaticResource MiniBarra}" />
                <TextBlock Text="{Binding Cpu}" Width="30" Margin="5,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="MEM" Foreground="{DynamicResource TextoSecundario}" FontSize="10" VerticalAlignment="Center" Margin="6,0,5,0" />
                <ContentPresenter Content="{Binding MemoriaFracao}" ContentTemplate="{StaticResource MiniBarra}" />
                <TextBlock Text="{Binding Memoria}" Width="30" Margin="5,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <Border Width="1" Height="14" Background="{DynamicResource Linha}" Margin="2,0,6,0"
                Visibility="{Binding MostrarDesempenho, Converter={StaticResource BoolParaVisivel}}" />

        <!-- Ícones dos apps (só com a doca ligada, quando o Vitral é o dono da bandeja) -->
        <Border x:Name="Setinha" Style="{StaticResource ItemIlha}" Visibility="Collapsed" ToolTip="Ícones dos apps" MouseLeftButtonUp="Icones_Clique" Margin="0,0,2,0">
            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource FonteIcones}" FontSize="11" VerticalAlignment="Center" />
        </Border>

        <!-- Rede -->
        <Border Style="{StaticResource ItemIlha}" ToolTip="Wi-Fi" MouseLeftButtonUp="Rede_Clique" Margin="0,0,2,0">
            <TextBlock Text="{Binding Rede, Converter={StaticResource RedeParaIcone}}" FontFamily="{StaticResource FonteIcones}" FontSize="13" VerticalAlignment="Center" />
        </Border>

        <!-- Volume: roda ±2, clique = painel -->
        <Border Style="{StaticResource ItemIlha}" ToolTip="Roda do mouse: volume. Clique: painel de volume" MouseWheel="Volume_Roda" MouseLeftButtonUp="Volume_Clique" Margin="0,0,2,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource FonteIcones}" FontSize="13" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#xE767;" />
                            <Style.Triggers><DataTrigger Binding="{Binding Mudo}" Value="True"><Setter Property="Text" Value="&#xE74F;" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Volume}" Margin="5,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Bateria (só com bateria) -->
        <Border Style="{StaticResource ItemIlha}" ToolTip="Bateria e energia" MouseLeftButtonUp="Bateria_Clique"
                Visibility="{Binding BateriaVisivel, Converter={StaticResource BoolParaVisivel}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding IconeBateria}" FontFamily="{StaticResource FonteIcones}" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Bateria}" Margin="5,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
