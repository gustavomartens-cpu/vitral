<UserControl x:Class="Vitral.App.Doca.ConteudoDoca"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A doca (spec da doca §5). O DataContext é o DocaViewModel. -->
    <UserControl.Resources>
        <Style x:Key="BotaoDoca" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" Background="Transparent" CornerRadius="8" Width="36" Height="36">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="Background" Value="{StaticResource SuperficieHover}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Button Style="{StaticResource BotaoDoca}" Command="{Binding IniciarCommand}" ToolTip="Iniciar">
            <Image Source="{StaticResource Logo}" Width="22" Height="22" />
        </Button>
        <Button Style="{StaticResource BotaoDoca}" Command="{Binding PesquisarCommand}" ToolTip="Pesquisar" Margin="2,0,0,0">
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource FonteIcones}" FontSize="16" />
        </Button>
        <Border Width="1" Height="24" Background="{StaticResource Linha}" Margin="8,0" VerticalAlignment="Center" />

        <ItemsControl ItemsSource="{Binding Botoes}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Width="40" Height="44" ToolTip="{Binding Nome}" Background="Transparent" AllowDrop="True"
                          PreviewMouseLeftButtonDown="Botao_Apertou" PreviewMouseMove="Botao_Moveu" Drop="Botao_Soltou"
                          MouseRightButtonUp="Botao_Direito">
                        <Button Style="{StaticResource BotaoDoca}" VerticalAlignment="Top" Margin="0,2,0,0"
                                Command="{Binding DataContext.ClicarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Grid Width="30" Height="30">
                                <!-- Pulso âmbar: o app pede atenção -->
                                <Border x:Name="Pulso" CornerRadius="8" Background="{StaticResource Ambar}" Opacity="0" />
                                <TextBlock x:Name="SemIcone" Text="&#xE737;" FontFamily="{StaticResource FonteIcones}" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                <Image Source="{Binding Icone}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Button>
                        <!-- Tracinho: aberto; marca âmbar com brilho: ativo -->
                        <Border x:Name="Marca" Height="3" Width="6" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                HorizontalAlignment="Center" Background="{StaticResource TextoSecundario}" Visibility="Hidden" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Icone}" Value="{x:Null}">
                            <Setter TargetName="SemIcone" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Aberto}" Value="True">
                            <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Ativo}" Value="True">
                            <Setter TargetName="Marca" Property="Width" Value="16" />
                            <Setter TargetName="Marca" Property="Background" Value="{StaticResource Ambar}" />
                            <Setter TargetName="Marca" Property="Effect">
                                <Setter.Value><DropShadowEffect Color="{StaticResource CorAmbar}" BlurRadius="8" ShadowDepth="0" Opacity="0.8" /></Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PedindoAtencao}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="Pulsar">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pulso" Storyboard.TargetProperty="Opacity"
                                                         From="0.1" To="0.55" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Pulsar" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
