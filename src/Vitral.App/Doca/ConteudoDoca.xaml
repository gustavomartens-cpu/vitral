<UserControl x:Class="Vitral.App.Doca.ConteudoDoca"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tema="clr-namespace:Vitral.App.Tema">
    <!-- A doca (spec da doca §5). O DataContext é o DocaViewModel. -->
    <UserControl.Resources>
        <Style x:Key="BotaoDoca" TargetType="Button">
            <Setter Property="tema:Efeitos.Afundar" Value="True" />
            <Setter Property="Foreground" Value="{DynamicResource Texto}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Fundo" Background="Transparent" CornerRadius="8" Width="{DynamicResource DocaFundoBotao}" Height="{DynamicResource DocaFundoBotao}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fundo" Property="Background" Value="{DynamicResource SuperficieHover}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Lupa (spec do ajuste visual §3.3): cresce o que tem AlvoDaLupa conforme a distância do mouse -->
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Background="Transparent" tema:Efeitos.Lupa="{DynamicResource DocaAmpliacao}">
        <Button Style="{StaticResource BotaoDoca}" Command="{Binding IniciarCommand}" ToolTip="Iniciar">
            <Image Source="{StaticResource Logo}" Width="{DynamicResource DocaLogo}" Height="{DynamicResource DocaLogo}" tema:Efeitos.AlvoDaLupa="True" />
        </Button>
        <Button Style="{StaticResource BotaoDoca}" Command="{Binding PesquisarCommand}" ToolTip="Pesquisar" Margin="2,0,0,0">
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource FonteIcones}" FontSize="{DynamicResource DocaFonteBusca}" tema:Efeitos.AlvoDaLupa="True" />
        </Button>
        <Border Width="1" Height="24" Background="{DynamicResource Linha}" Margin="8,0" VerticalAlignment="Center" />

        <ItemsControl x:Name="Itens" ItemsSource="{Binding Botoes}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid x:Name="Raiz" Width="{DynamicResource DocaBotaoLargura}" Height="{DynamicResource DocaBotaoAltura}" ToolTip="{Binding Nome}" Background="Transparent" AllowDrop="True"
                          PreviewMouseLeftButtonDown="Botao_Apertou" PreviewMouseMove="Botao_Moveu" Drop="Botao_Soltou"
                          MouseRightButtonUp="Botao_Direito" MouseUp="Botao_Meio"
                          MouseEnter="Botao_Entrou" MouseLeave="Botao_Saiu">
                        <Button Style="{StaticResource BotaoDoca}" VerticalAlignment="Top" Margin="0,2,0,0"
                                Command="{Binding DataContext.ClicarCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Grid Width="{DynamicResource DocaIcone}" Height="{DynamicResource DocaIcone}" tema:Efeitos.AlvoDaLupa="True">
                                <!-- Pulso âmbar: o app pede atenção -->
                                <Border x:Name="Pulso" CornerRadius="8" Background="{DynamicResource Ambar}" Opacity="0" />
                                <TextBlock x:Name="SemIcone" Text="&#xE737;" FontFamily="{StaticResource FonteIcones}" FontSize="18"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                <Image Source="{Binding Icone}" Width="{DynamicResource DocaImagem}" Height="{DynamicResource DocaImagem}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Button>
                        <!-- Tracinho: aberto; marca âmbar com brilho: ativo -->
                        <!-- Cores da aparência da doca: trocadas por Setter (animação de estilo não aceita cor dinâmica);
                             o brilho fica sempre ali e só a intensidade anima. -->
                        <Border x:Name="Marca" Height="3" Width="6" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                HorizontalAlignment="Center" Visibility="Hidden" Background="{DynamicResource TextoSecundario}">
                            <Border.Effect><DropShadowEffect Color="{DynamicResource CorAmbar}" BlurRadius="8" ShadowDepth="0" Opacity="0" /></Border.Effect>
                        </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Icone}" Value="{x:Null}">
                            <Setter TargetName="SemIcone" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding AtalhoExiste}" Value="False">
                            <Setter TargetName="Raiz" Property="Opacity" Value="0.4" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Aberto}" Value="True">
                            <Setter TargetName="Marca" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Ativo}" Value="True">
                            <!-- A marca cresce e esquenta com animação ao virar o ativo -->
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Marca" Storyboard.TargetProperty="Width" To="16" Duration="0:0:0.18" EasingFunction="{StaticResource CurvaMola}" />
                                        <DoubleAnimation Storyboard.TargetName="Marca" Storyboard.TargetProperty="Effect.Opacity" To="0.8" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Marca" Storyboard.TargetProperty="Width" To="6" Duration="0:0:0.18" EasingFunction="{StaticResource CurvaMola}" />
                                        <DoubleAnimation Storyboard.TargetName="Marca" Storyboard.TargetProperty="Effect.Opacity" To="0" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                            <Setter TargetName="Marca" Property="Background" Value="{DynamicResource Ambar}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding PedindoAtencao}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="Pulsar">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pulso" Storyboard.TargetProperty="Opacity"
                                                         From="0.1" To="0.55" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Pulsar" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
