<Window x:Class="Vitral.App.JanelaConfiguracoes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações" Icon="Recursos/vitral.ico" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Foreground="{StaticResource Texto}" FontFamily="{StaticResource FonteCorpo}" Background="{StaticResource Noite}">
    <!-- Configurações do Vitral (spec da interface §3.5): o que é do computador, não do perfil -->
    <StackPanel Margin="22,18,22,20">
        <TextBlock Text="Configurações" FontFamily="{StaticResource FonteTitulo}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />

        <Border Style="{StaticResource CartaoVidro}">
            <StackPanel>
                <CheckBox x:Name="IniciarComWindows" Content="Iniciar com o Windows" Style="{StaticResource Chave}"
                          Checked="IniciarComWindows_Mudou" Unchecked="IniciarComWindows_Mudou" />
                <!-- Avisos do Claude Code no notch (spec do notch vivo §4.6): liga os ganchos no settings.json do Claude -->
                <CheckBox x:Name="AvisosClaude" Content="Avisos do Claude no notch" Style="{StaticResource Chave}" Margin="0,14,0,0"
                          Checked="AvisosClaude_Mudou" Unchecked="AvisosClaude_Mudou" />
                <!-- Agenda no notch (spec da agenda §5.3): avisos ligados e as contas, da máquina -->
                <CheckBox x:Name="AgendaNoNotch" Content="Agenda no notch" Style="{StaticResource Chave}" Margin="0,14,0,0"
                          Checked="AgendaNoNotch_Mudou" Unchecked="AgendaNoNotch_Mudou" />
                <TextBlock Margin="0,4,0,0" FontSize="11.5" Foreground="{StaticResource TextoSecundario}">
                    <Run Text="Google e Outlook · " />
                    <Hyperlink Click="ContasAgenda_Click" Foreground="{StaticResource Ambar}" TextDecorations="None">Contas…</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Versão e atualização automática (spec da atualização §5.4) -->
        <Border Style="{StaticResource CartaoVidro}" Margin="0">
            <StackPanel>
                <TextBlock x:Name="TextoVersao" FontSize="12.5" />
                <TextBlock x:Name="TextoBuild" Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource TextoSecundario}" />
                <TextBlock x:Name="LinhaAtualizacao" Margin="0,8,0,0" FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource TextoSecundario}" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
